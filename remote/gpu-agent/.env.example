# ---- TextEnhanceAI GPU agent + vLLM ------------------------------------------
# Copy to .env and edit. The agent only needs outbound HTTPS to the relay.

# Public URL of your relay (the Strato server). The agent derives the
# WebSocket endpoint itself (wss://<host>/agent/ws).
RELAY_URL=https://relay.example.com
# One of the relay's RELAY_AGENT_KEYS (the value after "name:").
RELAY_AGENT_KEY=REPLACE_WITH_teai_agent_key
# Name shown in the relay status and in the TextEnhanceAI connection dialog.
AGENT_NAME=gpu-1
# How many requests vLLM should process at the same time through this agent.
AGENT_MAX_CONCURRENCY=4

# ---- vLLM ----------------------------------------------------------------------
# Hugging Face repo id of the model to serve. Use the exact id of the Qwen
# 27B checkpoint you want (a quantized variant if it must fit one GPU).
VLLM_MODEL=Qwen/Qwen3.5-27B
# Friendly name clients see in the model list (defaults to VLLM_MODEL).
VLLM_SERVED_MODEL_NAME=qwen-27b
# Context window; long documents need room for input + output tokens.
VLLM_MAX_MODEL_LEN=32768
# Fraction of GPU memory vLLM may reserve.
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Number of GPUs to shard the model across.
VLLM_TENSOR_PARALLEL_SIZE=1
# GPUs visible to vLLM: "all" or a comma-separated list of indices (e.g. 0,1).
NVIDIA_VISIBLE_DEVICES=all
# Concurrent sequences vLLM batches (raise on big GPUs).
VLLM_MAX_NUM_SEQS=16
# Extra vLLM flags. "--reasoning-parser qwen3" moves Qwen thinking output into
# reasoning_content so it never lands in the edited text. Remove it if your
# vLLM version rejects the parser name.
# --enable-prefix-caching is already part of the compose command.
VLLM_EXTRA_ARGS=--reasoning-parser qwen3
# Pin the vLLM image (e.g. v0.11.0) for reproducible deployments.
VLLM_IMAGE_TAG=latest
# Token for gated Hugging Face repos (optional).
HUGGING_FACE_HUB_TOKEN=
# Host directory for downloaded weights (defaults to a named Docker volume).
#HF_CACHE_DIR=/srv/hf-cache
# How long the vLLM healthcheck tolerates model loading.
VLLM_HEALTH_START_PERIOD=30m
# vLLM's OpenAI port on localhost, for local curl tests only.
VLLM_LOCAL_PORT=8000
# Agent health endpoint on localhost: curl http://127.0.0.1:8090/health
AGENT_LOCAL_PORT=8090

# ---- Optional agent tuning ------------------------------------------------------
# Set to false only for a relay with a self-signed certificate (testing).
#AGENT_TLS_VERIFY=true
# Maximum seconds for one generation before the agent gives up (default 900).
#AGENT_REQUEST_TIMEOUT=900
# Upper bound of the reconnect backoff in seconds (default 30).
#AGENT_RECONNECT_MAX_DELAY=30
# Set if vLLM itself was started with --api-key.
#VLLM_API_KEY=
# DEBUG, INFO (default), WARNING
#AGENT_LOG_LEVEL=INFO
# Seconds between vLLM metrics scrapes / status frames to the relay (default 10).
#AGENT_STATUS_INTERVAL=10
# SIGTERM ("docker compose stop") drains: in-flight requests finish, new ones are
# refused, then the agent exits (default true). false stops at once.
#AGENT_DRAIN_ON_TERM=true
# Seconds a drain waits for in-flight requests before aborting them (default 600).
#AGENT_DRAIN_TIMEOUT=600
