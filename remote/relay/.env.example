# ---- TextEnhanceAI relay configuration ------------------------------------
# Copy to .env and edit. Generate keys with:
#   docker compose run --rm relay python -m teai_relay keygen 3
# or, without Docker:  python -m teai_relay keygen 3

# Public host name that points at this server (Caddy requests a Let's Encrypt certificate
# for it). Use ":80" to run plain HTTP on port 80 without a certificate
# (testing only).
RELAY_DOMAIN=relay.example.com
# Email for Let's Encrypt expiry notices (optional but recommended).

# Keys that GPU agents use to connect: "name:key,name2:key2". The name shows
# up in logs and in the /status output. Rotate by editing and restarting.
RELAY_AGENT_KEYS=gpu-1:REPLACE_WITH_teai_agent_key

# Keys that TextEnhanceAI users (or any OpenAI-compatible client) present as
# "Authorization: Bearer ...". One entry per person makes revocation easy.
RELAY_CLIENT_KEYS=alice:REPLACE_WITH_teai_client_key,bob:REPLACE_WITH_another_key

# ---- Administration (optional) -----------------------------------------------
# A separate key for the admin API and status page (GET /admin, /admin/keys).
# Leave unset and the admin routes answer 404. Must differ from every other key.
#RELAY_ADMIN_KEY=REPLACE_WITH_teai_admin_key
# Keys created through the admin API or "python -m teai_relay keys add" are
# stored here (a Docker volume in docker-compose.yml). They are merged with the
# keys above; revoking works for both without a restart.
#RELAY_KEYS_FILE=/data/keys.json

# ---- Optional tuning ---------------------------------------------------------
# Public URL reported in /status (informational).
#RELAY_PUBLIC_URL=https://relay.example.com
# Seconds a request may wait for a free slot on a busy GPU (default 300).
#RELAY_QUEUE_TIMEOUT=300
# Seconds without any data from the agent before a request fails (default 180).
#RELAY_IDLE_TIMEOUT=180
# Interval of SSE keepalive comments while waiting (default 15).
#RELAY_KEEPALIVE_INTERVAL=15
# WebSocket ping interval to detect dead agents (default 20).
#RELAY_WS_HEARTBEAT=20
# Maximum request body in MB (default 16).
#RELAY_MAX_BODY_MB=16
# DEBUG, INFO (default), WARNING
#RELAY_LOG_LEVEL=INFO
